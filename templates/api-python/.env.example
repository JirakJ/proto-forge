# Runtime configuration (single source: src/app/config/env.py — nothing else reads the environment).
PORT=3000
# critical | error | warning | info | debug
LOG_LEVEL=info
# Required to serve and for `pnpm db:migrate` (alembic reads it too). No offline default:
# Python has no in-process Postgres engine (BRS 15/19, ADR 003).
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/notes
# Git commit of the running build; injected by CI, "dev" locally.
# GIT_SHA=dev
