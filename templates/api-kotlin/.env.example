# Runtime configuration (single source: app.config.Settings; logback.xml reads
# LOG_LEVEL again because a logging backend is configured before any of our
# Kotlin runs). No secret-shaped values belong in this file; real values live in
# the environment.

# HTTP port the service listens on.
PORT=8080

# Root SLF4J level: error | warn | info | debug | trace
LOG_LEVEL=info

# JDBC PostgreSQL connection string. REQUIRED for a main run: this service speaks
# to a served PostgreSQL only (BR-12/§15 — no in-memory stand-in exists). Tests
# need no database: slices run on the fixture repository, the real-engine tier
# runs under Testcontainers.
# DATABASE_URL=jdbc:postgresql://localhost:5432/notes?user=notes&password=change-me

# Stamped by CI into /version; "dev" locally.
GIT_SHA=dev
