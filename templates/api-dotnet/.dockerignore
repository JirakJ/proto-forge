# Keep the build context to what `dotnet publish src/App/App.csproj` actually
# reads: global.json, Directory.Build.props, the app project with its lock file
# and src/. Everything else is repo furniture — and bin/ and obj/ from a host
# build would poison the container restore with host-resolved paths.
**/bin
**/obj
build
node_modules
coverage
.git
.github
.husky
.claude
.config
.prompts
docs
contract
scripts
deploy
tests
*.local
.env
.DS_Store
Dockerfile
.dockerignore
