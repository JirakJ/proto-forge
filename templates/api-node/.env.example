# Runtime configuration (single source: src/config/env.ts — EnvSchema).
# No secret-shaped values belong in this file; real values live in the environment.

# HTTP port the service listens on.
PORT=3000

# pino level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# PostgreSQL connection string. Unset = in-process PGlite (the verify-time default);
# deployments point this at a served PostgreSQL.
# DATABASE_URL=postgresql://localhost:5432/notes

# Stamped by CI into /version; "dev" locally.
GIT_SHA=dev
