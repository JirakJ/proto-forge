{
  "name": "proto-forge-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "dotnet run --project src/App",
    "build": "dotnet build proto-forge-service.slnx --nologo --verbosity quiet",
    "start": "dotnet run --project src/App --no-build",
    "verify": "pnpm run config:check && pnpm run env:verify && pnpm run gates:selftest && pnpm run lint && pnpm run typecheck && pnpm run coverage:policy && pnpm run ignores && pnpm run test:unit && pnpm run test:mutation && pnpm run build && pnpm run deploy:verify && pnpm run deps:budget && pnpm run arch:verify && pnpm run opid:scan && pnpm run log:scan && pnpm run error:catalog && pnpm run migration:verify && pnpm run contract:verify && pnpm run contract:breaking && pnpm run docs:verify && pnpm run external:verify && pnpm run stub:scan && pnpm run adr:lint && pnpm run prompt:lint && pnpm run dup:scan && pnpm run consistency && pnpm run sec:scan && pnpm run sec:conformance && pnpm run snapshot:diff && pnpm run test:e2e && pnpm run quality:report && pnpm run status:verify",
    "lint": "dotnet build proto-forge-service.slnx --nologo --verbosity quiet",
    "typecheck": "dotnet build proto-forge-service.slnx --nologo --verbosity quiet --no-restore",
    "test:unit": "TZ=UTC dotnet test tests/App.Tests/App.Tests.csproj --nologo --filter \"Category!=conformance&Category!=capture&Category!=native\" -p:CollectCoverage=true --logger \"trx;LogFileName=unit.trx\" --results-directory build/test-results/unit",
    "test:e2e": "node scripts/e2e-conformance.mjs",
    "test:mutation": "dotnet tool restore && TZ=UTC dotnet stryker --output build/reports/stryker",
    "test:native": "TZ=UTC dotnet test tests/App.Tests/App.Tests.csproj --nologo --filter Category=native",
    "config:show": "node scripts/config-cli.mjs show",
    "config:check": "node scripts/config-cli.mjs check",
    "env:verify": "node scripts/env-verify.mjs",
    "deploy:verify": "node scripts/deploy-verify.mjs",
    "deploy:plan": "node scripts/deploy-cli.mjs plan",
    "env:local": "node scripts/env-local.mjs",
    "env:remote": "node scripts/env-remote.mjs",
    "gates:selftest": "node scripts/gates-selftest.mjs",
    "gates:selftest:native": "node scripts/gates-selftest-native.mjs",
    "deps:budget": "node scripts/deps-budget.mjs",
    "arch:verify": "node scripts/arch-verify.mjs",
    "opid:scan": "node scripts/opid-scan.mjs",
    "log:scan": "node scripts/log-scan.mjs",
    "ignores": "node scripts/ignore-registry.mjs",
    "coverage:policy": "node scripts/coverage-policy.mjs",
    "error:catalog": "node scripts/error-catalog.mjs",
    "migration:verify": "node scripts/migration-verify.mjs",
    "contract:verify": "node scripts/contract-verify.mjs",
    "contract:breaking": "node scripts/contract-breaking.mjs",
    "contract:generate": "node scripts/contract-generate.mjs",
    "docs:verify": "node scripts/docs-verify.mjs",
    "docs:examples": "node scripts/docs-examples.mjs",
    "external:verify": "node scripts/external-verify.mjs",
    "stub:scan": "node scripts/stub-scan.mjs",
    "adr:lint": "node scripts/adr-lint.mjs",
    "prompt:lint": "node scripts/prompt-log-lint.mjs",
    "dup:scan": "jscpd src --config .jscpd.json",
    "consistency": "node scripts/consistency.mjs",
    "sec:scan": "pnpm run sbom && node scripts/sec-scan.mjs",
    "sbom": "node scripts/sbom.mjs",
    "snapshot": "node scripts/snapshot-diff.mjs --write",
    "seed:lock": "node scripts/snapshot-diff.mjs --write-seed",
    "snapshot:diff": "node scripts/snapshot-diff.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "sync:jira": "node scripts/sync-jira.mjs",
    "sync:confluence": "node scripts/sync-confluence.mjs",
    "sync:pull": "node scripts/sync-pull.mjs",
    "sync:status": "node scripts/sync-status.mjs",
    "sync:auto": "node scripts/sync-auto.mjs",
    "quality:report": "node scripts/quality-report.mjs",
    "status:verify": "node scripts/status-verify.mjs",
    "doctor": "node scripts/doctor.mjs",
    "heal": "node scripts/heal.mjs",
    "prepare": "husky || true",
    "tools:restore": "dotnet tool restore",
    "sec:conformance": "node scripts/sec-conformance.mjs",
    "sec:conformance:write": "node scripts/sec-conformance.mjs --write"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "jscpd": "^4.2.5",
    "yaml": "^2.9.0"
  }
}
